#mirror vmbr0 to parrot, can only see parrot traffic right now... 
#add ingress mirroring on proxmox host
tc qdisc add dev vmbr0 ingress

#mirror everything entering vmbr0 toward the Parrot interface:
tc filter add dev vmbr0 parent ffff: \
matchall \
action mirred egress mirror dev fwpr200p0

#verify mirror
tc filter show dev vmbr0 parent ffff:

#test capture again should see all traffic within proxmox env
sudo tcpdump -i ens18 -nn

#test for all non (parrotos connections)
sudo tcpdump -i ens18 -nn not host 192.168.50.213


